{
  "version": 1,
  "atomic": {
    "max_top_level_dirs": 12
  },
  "guard": {
    "secret_patterns": [
      "(?<![A-Za-z0-9+/_=])AKIA[0-9A-Z]{16}(?![A-Za-z0-9+/_=])",
      "(?<![A-Za-z0-9])sk-[a-zA-Z0-9]{20,}",
      "api[_-]?key\\s*[:=]\\s*['\"][^'\"]{8,}",
      "-----BEGIN (RSA |EC )?PRIVATE KEY-----"
    ]
  }
}
